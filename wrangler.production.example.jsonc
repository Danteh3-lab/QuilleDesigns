{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "REPLACE_WITH_CONFIRMED_WORKER_NAME",
  "account_id": "REPLACE_WITH_CONFIRMED_ACCOUNT_ID",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-04",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "build/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REPLACE_WITH_CREATED_D1_NAME",
      "database_id": "REPLACE_WITH_CREATED_D1_ID",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "REPLACE_WITH_CONFIRMED_EXISTING_BUCKET_NAME",
    },
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://REPLACE_WITH_CONFIRMED_DOMAIN",
    "ACCESS_TEAM_DOMAIN": "https://REPLACE_WITH_ACCESS_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUDIENCE",
  },
  "triggers": { "crons": ["17 3 * * *"] },
}
