// Production Worker configuration used by Cloudflare Workers Builds on every push to main.
// Deploy command: npx wrangler deploy (the default). Wrangler runs the build below first.
// The account comes from the Cloudflare build environment. ADMIN_EMAILS is a Worker
// secret managed in Cloudflare and is never stored in this repository.
// Keep run_worker_first and html_handling: asset-first hosting would bypass /admin
// authentication, dynamic rendering and the booking API.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quilledesigns",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-04",
  "build": { "command": "node scripts/build.mjs" },
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "build/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quille-portfolio",
      "database_id": "7f2f18ef-31a7-4eb2-9bc9-66231fca61be",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "quille-media" }],
  "vars": {
    "PUBLIC_ORIGIN": "https://quilledesigns.toikromodanick.workers.dev",
    "ACCESS_TEAM_DOMAIN": "https://quilledesigns.cloudflareaccess.com",
    "ACCESS_AUD": "52a91c0db73dd3821232353f719091750957841c3635bed71a0141bdb124b81e"
  },
  "triggers": { "crons": ["17 3 * * *"] }
}
